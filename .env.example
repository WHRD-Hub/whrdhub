# Supabase Details (Get from project settings > API: https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authentication & Redirect Settings
# Locally: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Africa's Talking - USSD confirmation SMS (sent by /api/ussd/events on session end)
# Sandbox: username "sandbox" + sandbox API key. Live: your live username + key.
# Leave unset to disable SMS (the USSD report still saves).
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key

# OpenRouter - powers the in-app Resource Assistant chat (/api/chat)
# Get a key at https://openrouter.ai/keys. Leave unset to disable chat.
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional: override the model. Defaults to google/gemini-2.5-flash-lite
# (cheapest capable model on OpenRouter, strongly multilingual for Swahili).
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
